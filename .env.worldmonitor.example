# WorldMonitor JARVIS runtime tuning (first-party renderer only)
WORLDMONITOR_LIVE_QUERY_BUDGET=12
WORLDMONITOR_LIVE_RESULTS_PER_QUERY=4
WORLDMONITOR_LIVE_WORKERS=6
WORLDMONITOR_GDELT_QUERY_BUDGET=6
WORLDMONITOR_GDELT_WORKERS=4
# SVG map render budget. The full atlas remains available server-side.
WORLDMONITOR_MAP_POINT_BUDGET=1180
WORLDMONITOR_MAP_POINTS_PER_LAYER=170
WORLDMONITOR_LIVE_POINTS_PER_LAYER=220

# AI analysis (configure one or both)
