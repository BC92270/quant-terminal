# Quant Terminal — provider configuration template
# Copy only the variables you need to your environment or to
# .streamlit/secrets.toml. Never commit real credentials.
# The public-apis GitHub catalogue lists APIs; it does not distribute API keys.

# Shared historical/intraday market data
DATABENTO_API_KEY=
TWELVE_DATA_API_KEY=
ALPHA_VANTAGE_API_KEY=
COINGECKO_DEMO_API_KEY=
COINGECKO_API_KEY=

# Options / futures
THETADATA_API_KEY=
MASSIVE_API_KEY=
TRADIER_API_TOKEN=
# production or sandbox; sandbox market data is delayed.
TRADIER_ENV=production

# Fundamentals, company events and news
FMP_API_KEY=
FINNHUB_API_KEY=
NEWSAPI_KEY=
SEC_USER_AGENT="QuantTerminal research@example.com"

# Macro, rates, credit and identifiers
FRED_API_KEY=
OPENFIGI_API_KEY=
TRADING_ECONOMICS_API_KEY=

# FINRA OAuth (Market Psychology positioning adapter)
FINRA_CLIENT_ID=
FINRA_CLIENT_SECRET=

# WorldMonitor authenticated/optional sources
ACLED_ACCESS_TOKEN=
ACLED_EMAIL=
ACLED_PASSWORD=
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
NASA_FIRMS_MAP_KEY=
EIA_API_KEY=
COMTRADE_API_KEY=
AISSTREAM_API_KEY=
RELIEFWEB_APPNAME=
